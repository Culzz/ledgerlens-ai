# LedgerLens AI — environment template.
#
# This file is committed as a reference, and nothing reads it. The application
# loads `.env` and only `.env`, so a real value belongs there:
#
#   copy .env.example .env
#   python -m evaluation.check_provider   # confirms a key before a long run
#
# Every value below is a blank placeholder. Keep it that way.

# --- Application ---
APP_ENV=local
LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8000

# --- Database ---
DATABASE_URL=postgresql+psycopg://ledgerlens:ledgerlens@localhost:5432/ledgerlens

# --- LLM provider ---
# The app is provider-neutral. `fake` runs offline with no key and no spend, and
# is the default so a fresh checkout works end to end. Anything else must speak
# the OpenAI chat-completions shape: gemini, groq, cerebras, openrouter, openai,
# or a custom endpoint via LLM_BASE_URL.
#
# `gemini` is the easiest to start with - Google AI Studio issues a key for a
# Google account, no card. Groq's free tier is also card-free, though its signup
# has been unreliable.
LLM_PROVIDER=fake
LLM_MODEL=
LLM_BASE_URL=
# One key for whichever provider is selected. Provider-specific names below are
# used as a fallback when this is empty.
LLM_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
OPENAI_API_KEY=
CEREBRAS_API_KEY=
OPENROUTER_API_KEY=

LLM_REQUEST_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=2
# Free tiers are rate limited per minute. This spaces calls out on purpose, so a
# 429 costs a wait instead of a retry.
LLM_MIN_SECONDS_BETWEEN_CALLS=0
LLM_MAX_OUTPUT_TOKENS=
# Free tiers cost nothing, so cost is reported as 0 by policy. Set false to
# estimate against list prices from the price table instead.
LLM_FREE_TIER=true
# Hard ceiling to stop runaway evaluation cost. Enforced in code, persisted to
# disk so it survives a resumed run.
LLM_MONTHLY_BUDGET_USD=25
LLM_BUDGET_LEDGER_PATH=./data/llm_budget.json

# --- Embeddings (local, no API cost) ---
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# --- Uploads ---
UPLOAD_DIR=./data/uploads
MAX_UPLOAD_MB=25
ALLOWED_UPLOAD_EXTENSIONS=.pdf

# --- Evaluation ---
FINQA_DATA_DIR=./data/finqa
EVAL_SEED=42
