# LedgerLens AI — environment template
# Copy to `.env` and fill in. NEVER commit `.env`.

# --- Application ---
APP_ENV=local
LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8000

# --- Database ---
DATABASE_URL=postgresql+psycopg://ledgerlens:ledgerlens@localhost:5432/ledgerlens

# --- LLM provider (Milestone 2+). Keep the app provider-neutral. ---
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o
OPENAI_API_KEY=
LLM_REQUEST_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=2
# Hard ceiling to stop runaway evaluation cost. Enforced in code.
LLM_MONTHLY_BUDGET_USD=25

# --- Embeddings (local, no API cost) ---
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# --- Uploads ---
UPLOAD_DIR=./data/uploads
MAX_UPLOAD_MB=25
ALLOWED_UPLOAD_EXTENSIONS=.pdf

# --- Evaluation ---
FINQA_DATA_DIR=./data/finqa
EVAL_SEED=42
